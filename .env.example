# Copy this file as .env and fill in your values
# NEVER push the .env file to GitHub

# Discord bot token (get this from the Discord Developer Portal)
DISCORD_TOKEN=your_token_here

# Anthropic API key (optional - if not set, Meowmico uses predefined responses)
ANTHROPIC_API_KEY=your_api_key_here

# Port where the Go backend runs
BACKEND_PORT=8080